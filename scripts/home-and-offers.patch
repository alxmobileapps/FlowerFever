+const gemPackPrice = pack => window.FlowerFeverStore?.prices?.[pack.id] || pack.price;
+const gemPackCard = p => `<button class="gempack${p.noAds ? " noads" : ""}${p.starter ? " starter" : ""}" data-i="${GEM_PACKS.indexOf(p)}">${p.tag ? `<em>${p.tag}</em>` : ""}<span class="gpic">${GEM_SVG.repeat(p.n >= 150 ? 3 : p.n >= 50 ? 2 : 1)}</span><b>${p.n}</b><small>diamonds</small>${p.noAds ? `<strong>+ No forced ads</strong>` : p.lives ? `<strong>+ ${p.lives} free lifelines</strong>` : ""}<i>${gemPackPrice(p)}</i></button>`;
+const REMOVE_ADS_PACK = GEM_PACKS.find(pack => pack.noAds);
+
+async function purchaseGemPack(pack) {
+  if (pack.noAds && save.noAds) return false;
+  if (!await buyPack(pack)) return false;
+  if (pack.noAds && save.noAds) return true;
+  track("purchase", { id: pack.id, price: pack.price });
+  addGems(pack.n);
+  if (pack.noAds) {
+    save.noAds = true;
+    syncBanner();
+  }
+  if (pack.lives) save.freeLife = freeLives() + pack.lives;
+  if (pack.starter) save.starterBought = true;
+  persist();
+  sfx("win");
+  return true;
+}
+
+function showRemoveAdsOffer(next) {
+  if (!adsAllowed()) { next(); return; }
+  show(`<div class="ribbon">Remove ads</div><h2>Play without interruptions</h2>
+    <p>Remove banner and interstitial ads and get 100 diamonds.</p>
+    <div class="gempacks" style="grid-template-columns:minmax(0,160px);justify-content:center">${gemPackCard(REMOVE_ADS_PACK)}</div>
+    <p id="offerStatus" role="status" hidden></p>
+    <div class="btns"><button class="btn alt" id="offerLater">Continue playing</button></div>`, el => {
+    const buy = el.querySelector(".gempack"), later = el.querySelector("#offerLater");
+    const status = el.querySelector("#offerStatus");
+    let left = false;
+    const finish = () => {
+      if (left) return;
+      left = true;
+      next();
+    };
+    later.onclick = finish;
+    buy.onclick = async () => {
+      buy.disabled = true;
+      status.hidden = true;
+      if (await purchaseGemPack(REMOVE_ADS_PACK)) { finish(); return; }
+      if (left) return;
+      status.textContent = "Purchase not completed.";
+      status.hidden = false;
+      buy.disabled = false;
+    };
+  });
+}
+
